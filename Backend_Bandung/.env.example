DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
PORT=4000
# WAJIB diisi string acak (mis. `openssl rand -hex 64`) — JANGAN dibiarkan sama dengan nilai
# contoh ini. Kalau nilainya ketebak/diketahui, siapa pun bisa memalsukan token admin.
JWT_SECRET=<random-string-panjang-untuk-menandatangani-token-admin>

# Interface tempat server listen. Default 127.0.0.1 (cuma bisa diakses dari mesin sendiri) —
# set ke 0.0.0.0 hanya kalau memang perlu diakses dari luar (mis. di dalam container produksi
# di belakang reverse proxy).
HOST=127.0.0.1

# Set ke "production" saat deploy — Express baru menyembunyikan stack trace di halaman error
# bawaannya kalau NODE_ENV=production.
NODE_ENV=development

# Origin frontend Dashboard Bandung — dipakai buat batasi CORS /api/categories, /api/admin,
# dan /uploads (bukan /api/v1, yang memang dibuka publik). WAJIB diisi ke domain produksi
# saat deploy (mis. https://opendata.bandung.go.id), default di kode cuma buat localhost dev.
FRONTEND_ORIGIN=http://localhost:3000

# SMTP untuk email konfirmasi/notifikasi formulir "Ajukan Permintaan API" (opsional —
# kalau SMTP_HOST kosong, permintaan tetap tersimpan ke DB tapi email dilewati).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@bandung.go.id
ADMIN_NOTIFY_EMAIL=
